discovery.docker "trofos_containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=trofos"]
  }
}

loki.source.docker "container_logs" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.docker.trofos_containers.targets
  forward_to = [loki.process.pino_logs.receiver]
}

loki.process "pino_logs" {
  stage.json {
    expressions = {
      level = "",
      timestamp = "",
      env = "",
      service_name = "",
      request_method = "",
      request_url = "",
      response_status_code = "",
    }
    drop_malformed = true
  }
  stage.drop {
    source = "level, timestamp"
    expression = "^$"
  }
  stage.labels {
    values = {
      level = "",
      env  = "",
      service_name = "",
    }
  }
  stage.structured_metadata {
    values = {
      request_method  = "",
      request_url = "",
      response_status_code = "",
    }
  }
  forward_to = [loki.write.grafana_loki.receiver]
}

faro.receiver "faro_frontend" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["http://localhost:3000", "http://localhost:3001", "http://localhost"]
  }
  log_format = "json"
  output {
    logs = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.grafana_tempo.input]
  }
}

loki.process "faro_logs" {
  stage.json {
    expressions = {
      env = "app_environment",
      service_name = "app_name",
      kind="",
    }
  }
  stage.labels {
    values = {
      env = "",
      service_name = "",
    }
  }
  stage.structured_metadata {
    values = {
      kind="",
    }
  }
  forward_to = [loki.write.grafana_loki.receiver]
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "trace_receivers" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.grafana_tempo.input]
  }
}

otelcol.exporter.otlp "grafana_tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}